def atomic_json(path, value):
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n")
    temporary.replace(path)


def read_json(path, default=None):
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, ValueError):
        return default


@contextlib.contextmanager
def lock(name, blocking=True):
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / name).open("a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        yield


def process_identity(pid):
    """PID 加启动时间，避免 PID 复用时误杀其他任务；僵尸进程不算存活。"""
    try:
        fields = Path(f"/proc/{int(pid)}/stat").read_text().rsplit(")", 1)[1].split()
        return None if fields[0] == "Z" else fields[19]
    except (OSError, ValueError, IndexError):
        return None


def is_our_worker(record):
    pid = record["pid"]
    if not record.get("identity") or process_identity(pid) != record["identity"]:
        return False
    try:
        env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        return b"XIANCUN_ROLE=worker" in env and f"XIANCUN_STATE_DIR={STATE}".encode() in env
    except OSError:
        return False


def terminate_workers(records):
    """只处理本脚本创建且身份匹配的进程，同时发信号，最多等待 5 秒。"""
    live = [record for record in records if is_our_worker(record)]
    for record in live:
        try:
            os.kill(record["pid"], signal.SIGTERM)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline and any(is_our_worker(r) for r in live):
        time.sleep(0.1)
    for record in live:
        if is_our_worker(record):
            try:
                os.kill(record["pid"], signal.SIGKILL)
            except ProcessLookupError:
                pass


def smi_rows(query):
    result = subprocess.run(
        [NVIDIA_SMI, query, "--format=csv,noheader,nounits"],
        capture_output=True, text=True, timeout=10, check=True,
    )
    return [list(map(str.strip, row)) for row in csv.reader(result.stdout.splitlines()) if row]


def snapshot():
    gpus = []
    for row in smi_rows("--query-gpu=index,uuid,utilization.gpu,memory.free"):
        index, uuid, utilization, free = row
        gpus.append({"index": int(index), "uuid": uuid, "util": int(utilization), "free": int(free)})
    visible = os.environ.get("CUDA_VISIBLE_DEVICES")
    if visible is not None:
        tokens = [token.strip() for token in visible.split(",") if token.strip()]
        allowed = {g["index"] for g in gpus for token in tokens
                   if token == str(g["index"]) or (token.startswith("GPU-") and g["uuid"].startswith(token))}
        gpus = [g for g in gpus if g["index"] in allowed]
    if not gpus:
        raise RuntimeError("没有检测到可用 GPU；请检查 GPU 分配和 CUDA_VISIBLE_DEVICES")
    apps = [{"uuid": uuid, "pid": int(pid)}
            for uuid, pid in smi_rows("--query-compute-apps=gpu_uuid,pid")]
    return sorted(gpus, key=lambda g: g["index"]), apps


def gpu_diagnosis(error):
    """Explain the failure at the device/driver boundary without changing the host."""
    detail = ((getattr(error, "stderr", "") or "") + "\n"
              + (getattr(error, "stdout", "") or "")).strip() or str(error)
    devices = list(Path("/dev").glob("nvidia[0-9]*"))
    driver_loaded = Path("/proc/driver/nvidia/version").exists()
    if isinstance(error, FileNotFoundError):
        advice = ("未找到 nvidia-smi。请使用平台提供的 NVIDIA GPU 镜像，"
                  "或在宿主机安装 NVIDIA 驱动；可用 XIANCUN_NVIDIA_SMI 指定现有命令。")
    elif not devices and driver_loaded:
        advice = ("宿主机 NVIDIA 内核驱动已加载，但当前环境没有 /dev/nvidia0 等 GPU 设备。"
                  "这通常是沙箱隔离或容器没有挂载 GPU，不是需要重装驱动。"
                  "请在开发机的普通终端运行；由 AI 执行时需授予沙箱外设备访问权限。"
                  "云平台请重新分配 GPU/选择 GPU 镜像；Docker 需在宿主机配置 NVIDIA Container Toolkit，"
                  "并用 --gpus all 启动容器。容器内部脚本无法自行解除宿主机的设备隔离。")
    elif not devices:
        advice = ("当前环境没有 NVIDIA GPU 设备。请确认开发机已分配 GPU；"
                  "在宿主机检查驱动，再将 GPU 挂载到容器。脚本不会重装驱动或创建伪设备节点。")
    elif "mismatch" in detail.lower():
        advice = ("NVIDIA 驱动内核模块与用户态库版本不一致。请由平台管理员在宿主机统一驱动版本，"
                  "必要时重启宿主机；不要在业务容器内重复安装驱动。")
    else:
        advice = ("设备节点存在，但驱动查询失败。请检查当前用户的设备权限、容器设备授权、"
                  "NVIDIA_VISIBLE_DEVICES 和 NVIDIA_DRIVER_CAPABILITIES（需 compute,utility）。"
                  "若宿主机的 nvidia-smi 也失败，需要平台管理员修复宿主机驱动。")
    return f"GPU 检查失败：{detail}\n{advice}"


def require_gpu():
    try:
        return snapshot()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        raise RuntimeError(gpu_diagnosis(error)) from error



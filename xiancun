def self_python():
    """Return the interpreter selected for workers, with a portable fallback."""
    config = read_json(STATE / "config.json", {})
    return str(config.get("python") or sys.executable) if isinstance(config, dict) else sys.executable


def supervisor_available():
    return bool(SUPERVISORD and SUPERVISORCTL
                and os.access(SUPERVISORD, os.X_OK)
                and os.access(SUPERVISORCTL, os.X_OK))


def set_backend(name):
    (STATE / "backend").write_text(name + "\n")


def get_backend():
    try:
        return (STATE / "backend").read_text().strip()
    except FileNotFoundError:
        return ""


def supervisorctl(*args):
    if not supervisor_available():
        raise RuntimeError("未找到 Supervisor，将使用内置后台监测")
    return subprocess.run([SUPERVISORCTL, "-c", str(STATE / "supervisord.conf"), *args],
                          text=True, capture_output=True, timeout=25)


def monitor_record():
    path = STATE / "monitor.pid"
    record = read_json(path, {})
    if not isinstance(record, dict) or not record.get("pid") or not record.get("identity"):
        return None
    if process_identity(record["pid"]) != record.get("identity"):
        path.unlink(missing_ok=True)
        return None
    return record


def terminate_local_monitor():
    record = monitor_record()
    if not record:
        return
    try:
        os.kill(record["pid"], signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline and monitor_record():
        time.sleep(0.1)
    if monitor_record():
        try:
            os.kill(record["pid"], signal.SIGKILL)
        except ProcessLookupError:
            pass
    (STATE / "monitor.pid").unlink(missing_ok=True)
    child = LOCAL_MONITORS.pop(record["pid"], None)
    if child is not None:
        child.wait(timeout=5)


def start_local_monitor():
    if monitor_record():
        return
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / "service.log").open("a") as log:
        child = subprocess.Popen(
            [sys.executable, str(SELF), "__monitor"],
            env=dict(os.environ, XIANCUN_STATE_DIR=str(STATE)),
            stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    # Only the child writes its identity after acquiring monitor.lock. Wait for
    # that handshake so a failed/duplicate start never reports a false success.
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if child.poll() is not None:
            raise RuntimeError("后台监测启动失败，请执行 ./xiancun log 查看 service.log")
        record = monitor_record()
        if record and record["pid"] == child.pid:
            LOCAL_MONITORS[child.pid] = child
            return
        time.sleep(0.05)
    child.terminate()
    child.wait(timeout=5)
    raise RuntimeError("后台监测启动超时，请执行 ./xiancun log")


def stop_service():
    if get_backend() == "supervisor" and supervisor_available() and (STATE / "supervisord.conf").exists():
        try:
            result = supervisorctl("stop", "xiancun")
            if result.returncode and not monitor_record():
                raise RuntimeError(result.stdout + result.stderr)
        except (OSError, RuntimeError, subprocess.SubprocessError):
            if not monitor_record():
                raise
    terminate_local_monitor()


def python_supports_torch(path):
    """Check a real CUDA operation, not merely import of a CPU-only torch wheel."""
    probe = """import torch
assert torch.cuda.is_available(), 'CUDA unavailable'
a = torch.ones((16, 16), device='cuda', dtype=torch.float16)
b = a @ a
torch.cuda.synchronize()
assert b[0, 0].item() == 16
"""
    try:
        result = subprocess.run(
            [path, "-c", probe],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=60,
        )
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def discover_worker_python(install=False):
    candidates = [
        os.environ.get("XIANCUN_PYTHON"),
        sys.executable,
        shutil.which("python3"),
        shutil.which("python"),
        str(Path.home() / "miniforge/envs/gpu-keepalive/bin/python"),
        str(Path.home() / "miniforge3/bin/python"),
        str(Path.home() / "miniconda3/bin/python"),
        str(Path.home() / "anaconda3/bin/python"),
        str(SELF.parent / ".venv/bin/python"),
        str(STATE / "runtime/bin/python"),
    ]
    # Conda environments may live outside PATH on a fresh platform image.
    for root in ("miniforge", "miniforge3", "miniconda3", "anaconda3"):
        candidates.extend(str(p) for p in (Path.home() / root / "envs").glob("*/bin/python"))
    if os.environ.get("XIANCUN_PYTHON"):
        candidates = [os.environ["XIANCUN_PYTHON"]]
        install = False
    seen = set()
    for candidate in candidates:
        if not candidate or candidate in seen or not os.access(candidate, os.X_OK):
            continue
        seen.add(candidate)
        if python_supports_torch(candidate):
            return candidate
    if install:
        return install_runtime()
    raise ValueError("未找到能执行 CUDA 计算的 PyTorch 环境（CPU 版 torch 不算通过）。"
                     "请运行 ./xiancun start 自动安装独立环境，或用 XIANCUN_PYTHON 指定 CUDA Python。"
                     "若已安装 CUDA PyTorch，请检查 CUDA_VISIBLE_DEVICES、驱动和 GPU 架构兼容性。")


def install_runtime():
    """Install only into our private venv; never change the user's training env."""
    override = os.environ.get("XIANCUN_TORCH_INDEX_URL")
    if override:
        index = override
    else:
        drivers = smi_rows("--query-gpu=driver_version")
        major = min(int(row[0].split(".")[0]) for row in drivers)
        index = "https://download.pytorch.org/whl/" + ("cu128" if major >= 570 else "cu118")
    runtime = STATE / "runtime"
    print(f"没有可用的 CUDA PyTorch，正在创建独立环境：{runtime}", flush=True)
    print(f"将从 {index} 下载 torch 及依赖（可能需要数 GB 和数分钟）。", flush=True)
    try:
        venv.EnvBuilder(with_pip=True).create(runtime)
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError("创建虚拟环境失败；Debian/Ubuntu 请先安装 python3-venv，"
                           "或使用带 venv 的 Python 再运行。详细错误：" + str(error)) from error
    python = str(runtime / "bin/python")
    subprocess.run([python, "-m", "pip", "install", "--disable-pip-version-check",
                    "torch", "--index-url", index], check=True)
    if not python_supports_torch(python):
        raise RuntimeError("依赖已安装，但 CUDA 实测仍失败。请运行 ./xiancun doctor 检查设备授权、"
                           "CUDA_VISIBLE_DEVICES 和驱动；也可用 XIANCUN_TORCH_INDEX_URL 选择兼容的官方 wheel 源。")
    return python


def ensure_service():
    if not (STATE / "enabled").exists():
        return
    requested = os.environ.get("XIANCUN_BACKEND", "auto")
    if requested not in ("auto", "builtin", "supervisor"):
        raise ValueError("XIANCUN_BACKEND 必须是 auto、builtin 或 supervisor")
    if requested == "builtin" or (requested == "auto" and get_backend() == "builtin"):
        set_backend("builtin")
        start_local_monitor()
        return "builtin"
    if not supervisor_available():
        set_backend("builtin")
        start_local_monitor()
        return "builtin"
    try:
        path = STATE / "supervisord.conf"
        if path.exists():
            result = supervisorctl("status", "xiancun")
            if "RUNNING" in result.stdout or "STARTING" in result.stdout:
                set_backend("supervisor")
                return "supervisor"
            if any(s in result.stdout for s in ("STOPPED", "EXITED", "FATAL")):
                result = supervisorctl("start", "xiancun")
                if result.returncode:
                    raise RuntimeError(result.stdout + result.stderr)
                set_backend("supervisor")
                return "supervisor"
        path = write_supervisor_config()
        terminate_local_monitor()
        subprocess.run([SUPERVISORD, "-c", str(path)], check=True, timeout=15,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        set_backend("supervisor")
        return "supervisor"
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        # Supervisor is optional. A restricted container or a broken system
        # install must not prevent the generic command from starting.
        with (STATE / "service.log").open("a") as log:
            log.write(f"Supervisor 不可用，改用内置后台进程：{error}\n")
        set_backend("builtin")
        start_local_monitor()
        return "builtin"


def config_from_args(args):
    stored = read_json(STATE / "config.json", {})
    config = dict(DEFAULTS, **(stored if isinstance(stored, dict) else {}))
    for key in DEFAULTS:
        value = getattr(args, key, None)
        if value is not None:
            config[key] = value
    if os.environ.get("XIANCUN_PYTHON"):
        config["python"] = os.environ["XIANCUN_PYTHON"]
    for key in ("memory_gib", "rotation_hours", "interval", "idle_seconds", "heartbeat_timeout"):
        value = config[key]
        if not math.isfinite(value) or value <= 0:
            raise ValueError(f"{key} 必须为正数")
    if config["memory_gib"] < 0.125 or config["gpu_count"] < 1:
        raise ValueError("显存至少 0.125 GiB，GPU 数至少 1")
    if config["interval"] > 60 or config["idle_seconds"] > 300:
        raise ValueError("检测间隔最多 60 秒，空闲确认最多 300 秒")
    if not os.access(config["python"], os.X_OK):
        if os.environ.get("XIANCUN_PYTHON"):
            raise ValueError("找不到工作进程 Python：" + config["python"])
        config["python"] = discover_worker_python(install=not getattr(args, "no_install", False))
    elif not python_supports_torch(config["python"]):
        if os.environ.get("XIANCUN_PYTHON"):
            raise ValueError("指定的 Python 无法执行 CUDA PyTorch 计算：" + config["python"]
                             + "；请运行 ./xiancun doctor 检查驱动、设备授权和 PyTorch CUDA 版本")
        config["python"] = discover_worker_python(install=not getattr(args, "no_install", False))
    return config


def show_status():
    enabled = (STATE / "enabled").exists()
    print("后台监测：" + ("已启用" if enabled else "已禁用"))
    backend = get_backend()
    if backend == "supervisor" and supervisor_available() and (STATE / "supervisord.conf").exists():
        result = supervisorctl("status", "xiancun")
        print((result.stdout + result.stderr).strip())
    elif backend == "builtin":
        record = monitor_record()
        print(f"内置后台监测：运行中 PID={record['pid']}" if record else "内置后台监测：未运行")
    elif enabled:
        print(("内置后台监测" if backend == "builtin" else "后台监测") + "：未运行")
    config = read_json(STATE / "config.json", DEFAULTS)
    if not isinstance(config, dict):
        config = dict(DEFAULTS)
    print(f"每 {config['interval']:g} 秒检测；连续空闲 {config['idle_seconds']:g} 秒后计算；"
          f"目标 {config['gpu_count']} 卡 × {config['memory_gib']:g} GiB；"
          f"每 {config['rotation_hours']:g} 小时轮换")
    print(f"空闲依据：外部 GPU 利用率 ≤ {config['util_threshold']}%；驻留 CUDA 进程不阻止计算")
    state = read_json(STATE / "status.json", {})
    if state:
        age = time.time() - state["updated"]
        print(f"最近状态：{state['mode']} — {state['reason']}（{age:.0f} 秒前）")
        if age > max(90, config["interval"] * 3):
            print("注意：监测状态已过期，请执行 xiancun start 并查看 xiancun log")
        if state.get("busy_gpus"):
            print("已让出的 GPU：" + "; ".join(state["busy_gpus"].values()))
        for gpu, record in state.get("workers", {}).items():
            heartbeat = read_json(STATE / f"heartbeat-{gpu}.json", {})
            valid = heartbeat.get("pid") == record["pid"]
            age = time.monotonic() - heartbeat.get("monotonic", 0)
            alive = is_our_worker(record)
            detail = f"最近计算心跳 {age:.0f} 秒前" if valid else "等待计算心跳"
            print(f"GPU {gpu}：PID={record['pid']}，{'存活' if alive else '已退出'}，{detail}")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "__worker":
        worker(float(sys.argv[2]), Path(sys.argv[3]), int(sys.argv[4]))
        return
    STATE.mkdir(parents=True, exist_ok=True)
    if len(sys.argv) > 1 and sys.argv[1] == "__monitor":
        require_proc()
        handler = RotatingFileHandler(STATE / "monitor.log", maxBytes=5 * 1024 * 1024, backupCount=2)
        handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(message)s"))
        LOG.addHandler(handler)
        LOG.setLevel(logging.INFO)
        with lock("monitor.lock", blocking=False):
            atomic_json(STATE / "monitor.pid", {"pid": os.getpid(), "identity": process_identity(os.getpid())})
            try:
                config = read_json(STATE / "config.json", {})
                Monitor(dict(DEFAULTS, **(config if isinstance(config, dict) else {}))).run()
            finally:
                record = read_json(STATE / "monitor.pid", {})
                if record.get("pid") == os.getpid():
                    (STATE / "monitor.pid").unlink(missing_ok=True)
        return
    parser = argparse.ArgumentParser(description="按 GPU 实际利用率判断空闲；驻留 CUDA 进程不阻止计算。")
    commands = parser.add_subparsers(dest="command", required=True)
    start = commands.add_parser("start", help="检查 GPU、自动准备依赖并启动后台监测")
    run = commands.add_parser("run", help="在当前终端持续监测，不依赖 Supervisor")
    for command in (start, run):
        command.add_argument("memory_gib", nargs="?", type=float)
        command.add_argument("rotation_hours", nargs="?", type=float)
        command.add_argument("--interval", type=float)
        command.add_argument("--idle-seconds", type=float)
        command.add_argument("--gpu-count", type=int)
        command.add_argument("--no-install", action="store_true", help="缺少 CUDA PyTorch 时仅报错，不下载依赖")
    commands.add_parser("doctor", help="诊断 GPU 设备、驱动和 CUDA PyTorch（不安装依赖）")
    commands.add_parser("ensure", help="自启动入口，仅在已启用时恢复服务")
    commands.add_parser("status", help="显示监测和真实计算心跳")
    commands.add_parser("log", help="查看监测、工作进程及服务日志")
    pause = commands.add_parser("pause", help="暂时释放 GPU，指定分钟数后自动恢复监测")
    pause.add_argument("minutes", nargs="?", default=10.0, type=float)
    commands.add_parser("stop", help="彻底禁用自动监测及自启动（训练前请用 pause）")
    args = parser.parse_args()
    if args.command == "doctor":
        doctor()
        return
    if args.command == "status":
        show_status()
        return
    if args.command == "log":
        for name in ("monitor.log", "compute.log", "service.log"):
            print(f"== {name} ==")
            try:
                print("".join((STATE / name).read_text(errors="replace").splitlines(True)[-30:]), end="")
            except FileNotFoundError:
                pass
        return
    if args.command == "run":
        require_gpu()
        require_proc()
        config = config_from_args(args)
        handler = RotatingFileHandler(STATE / "monitor.log", maxBytes=5 * 1024 * 1024, backupCount=2)
        handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(message)s"))
        LOG.addHandler(handler)
        LOG.addHandler(logging.StreamHandler(sys.stdout))
        LOG.setLevel(logging.INFO)
        with lock("monitor.lock", blocking=False):
            atomic_json(STATE / "config.json", config)
            Monitor(config).run()
        return
    with lock("control.lock"):
        if args.command == "start":
            require_gpu()
            require_proc()
            config = config_from_args(args)
            changed = config != read_json(STATE / "config.json", {})
            atomic_json(STATE / "config.json", config)
            atomic_json(STATE / "control.json", {"pause_until": 0})
            (STATE / "enabled").touch()
            if changed and get_backend() == "supervisor" and supervisor_available() and (STATE / "supervisord.conf").exists():
                supervisorctl("stop", "xiancun")
            elif changed and get_backend() == "builtin":
                terminate_local_monitor()
            backend = ensure_service()
            backend = "Supervisor" if backend == "supervisor" else "内置后台进程"
            print(f"已启用自动监测（{backend}）；默认外部 GPU 利用率归零后约 30–60 秒启动计算进程。")
        elif args.command == "ensure":
            ensure_service()
        elif args.command == "pause":
            if not math.isfinite(args.minutes) or args.minutes <= 0:
                raise ValueError("暂停分钟数必须为正数")
            if not (STATE / "enabled").exists():
                raise ValueError("自动监测未启用，请先执行 xiancun start")
            atomic_json(STATE / "control.json", {"pause_until": time.time() + args.minutes * 60})
            stop_service()
            ensure_service()
            print(f"已释放 GPU，暂停 {args.minutes:g} 分钟后自动继续监测。")
        elif args.command == "stop":
            (STATE / "enabled").unlink(missing_ok=True)
            stop_service()
            (STATE / "backend").unlink(missing_ok=True)
            terminate_workers(list(read_json(STATE / "workers.json", {}).values()))
            print("已彻底停止并禁用自启动；重新启用请执行 xiancun start。")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"xiancun: {error}", file=sys.stderr)
        sys.exit(1)

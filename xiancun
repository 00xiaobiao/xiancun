def find_command(environment, names, fallback_paths=()):
    """Find an optional system command without requiring a machine-specific path."""
    configured = os.environ.get(environment)
    if configured and os.access(configured, os.X_OK):
        return configured
    for name in names:
        found = shutil.which(name)
        if found:
            return found
    for path in fallback_paths:
        if os.access(path, os.X_OK):
            return path
    return None


